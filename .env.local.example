# Get a free project ID at https://cloud.reown.com (formerly WalletConnect Cloud)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Redis (XP + leaderboard + connected accounts). Create a free Redis
# database from the Vercel dashboard: Project -> Storage -> Create
# Database -> Redis (Marketplace, powered by Upstash). It auto-fills
# these when connected to your project; for local dev run
# `vercel env pull .env.local`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public base URL of this deployment. MUST exactly match the redirect
# URIs you register in the X and Discord developer consoles below.
APP_URL=http://localhost:3000

# --- X (Twitter) "Sign in with X" OAuth 2.0 ---
# 1. Go to https://developer.x.com -> create a Project + App (free tier).
# 2. In the App's "User authentication settings", enable OAuth 2.0,
#    set App permissions to "Read", type "Web App".
# 3. Callback URI: {APP_URL}/api/auth/x/callback
#    (e.g. https://your-domain.vercel.app/api/auth/x/callback)
# 4. Copy the OAuth 2.0 Client ID and Client Secret below.
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Discord OAuth2 ---
# 1. Go to https://discord.com/developers/applications -> New Application.
# 2. OAuth2 -> General -> add Redirect: {APP_URL}/api/auth/discord/callback
# 3. Copy the Client ID and Client Secret (OAuth2 -> General) below.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: your Discord server's ID (right-click server icon -> Copy
# Server ID, with Developer Mode on). If set, "Join our Discord server"
# is verified for real against the member's guild list.
DISCORD_GUILD_ID=
